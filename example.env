VEKTOR_API_URL=http://127.0.0.1:4321
VEKTOR_COLLABORATION_HOST=127.0.0.1:8080
VEKTOR_SITE_URL=http://127.0.0.1:4321

# Document publication and comment email notifications. Delivery remains
# disabled in production until both VEKTOR_EMAIL_FROM and VEKTOR_SMTP_HOST are set.
VEKTOR_EMAIL_FROM="Vektor <notifications@example.com>"
VEKTOR_SMTP_HOST="smtp.example.com"
VEKTOR_SMTP_PORT="587"
VEKTOR_SMTP_SECURE="0"
VEKTOR_SMTP_USER=""
VEKTOR_SMTP_PASSWORD=""

# Set to "1" together with VEKTOR_NO_AUTH=1 for a fully ephemeral test server
# VEKTOR_IN_MEMORY_DB=1

# API rate limiting. On by default: callers are counted per access token, or per
# IP when there is no token, and expensive routes (search rebuild, chat
# completions, workflow and job runs, link previews, media proxy, uploads) carry
# tighter limits of their own that these settings do not raise. Responses carry
# X-Limit-Remaining; a refusal is 429 with Retry-After.
# VEKTOR_RATE_LIMIT=0            # turn limiting off entirely
# VEKTOR_RATE_LIMIT_MAX=600      # requests per window on ordinary routes
# VEKTOR_RATE_LIMIT_WINDOW=60    # window length in seconds
#
# Killswitch for an integration that is hammering the instance right now. Takes
# the keys exactly as the 429 log line reports them, comma-separated; those
# callers are refused without being counted. A token key is a hash, so blocking
# one never means writing a credential down here.
# VEKTOR_RATE_LIMIT_BLOCK=ip:203.0.113.7,token:9f86d081884c7d65

# Base URL of a Gravatar-compatible avatar API, used as <host>/avatar/<hash> for
# users whose login provider supplied no picture. Unset means no lookup happens:
# it discloses a hash of every such user's email to that host, which then also
# sees the IP of everyone viewing the avatar. Anyone the host has no picture for
# keeps the generated in-app avatar.
# VEKTOR_GRAVATAR_URL=https://gravatar.com
# VEKTOR_GRAVATAR_URL=https://seccdn.libravatar.org

AUTH_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Name, picture and the `wiki_groups` claim are re-read from the provider on
# every sign-in, and again from its userinfo endpoint whenever a signed-in user's
# copy is older than OAUTH_GROUP_SYNC_INTERVAL (below) — so a group revoked
# upstream stops granting access within about a minute instead of at next login.
# Include offline_access in OAUTH_SCOPES: the re-read needs a refresh token once
# the access token from sign-in has expired.
OAUTH_AUTHORIZATION_URL="https://example.com/oauth/authorize"
OAUTH_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
OAUTH_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
OAUTH_PROVIDER_ID="sso"
OAUTH_SCOPES="email,profile,openid,offline_access"
OAUTH_TOKEN_URL="https://example.com/oauth/token"
OAUTH_USERINFO_URL="https://example.com/oauth/userinfo"
# Seconds a user's groups may age before the next re-read. 0 turns the re-read
# off, leaving group changes to land at the next sign-in. A re-read that fails
# changes nothing — stored groups keep working and the next one tries again.
# OAUTH_GROUP_SYNC_INTERVAL=60

# Restrict who may create a space of their own to members of these OAuth groups.
# Unset, every signed-in user may create one. Set but naming no usable group,
# nobody may — a misconfigured allow list denies rather than opening up. The
# synthetic "public" group is ignored here; everyone carries it.
# VEKTOR_SPACE_CREATION_GROUPS=space-admins,platform-team

# Instance administrators: members of these OAuth groups are owner on every
# space that exists, so they see all spaces under /spaces and can administer or
# delete any of them. Unset, nobody is — unlike the allow list above, an absent
# setting grants nothing. "public" is ignored here too.
# VEKTOR_ADMIN_GROUPS=vektor-admins

# Google login. Set both to enable a "Continue with Google" button on the login
# screen. Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# and add "<SITE_URL>/api/auth/callback/google" as an authorized redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: override the redirect URI (defaults to <SITE_URL>/api/auth/callback/google)
# GOOGLE_REDIRECT_URI=""

OPENROUTER_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
OPENROUTER_MODEL="qwen/qwen3.5-397b-a17b"
# Provider priority: Ollama, then Anthropic, then OpenRouter
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"
# A space's live Ollama base URL is set in space settings, not here. Either way a
# loopback or private-network host is refused unless the server runs with
# VEKTOR_JOB_FETCH_ALLOW_PRIVATE=1 (see Jobs below).
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3:latest"

# CLI Env
VEKTOR_URL=http://127.0.0.1:4321/
VEKTOR_SPACE_ID="xxx"
VEKTOR_TOKEN="xxx"

# ── Jobs ──────────────────────────────────────────────────────────────────────
# Which runtime executes extension jobs and workflow scripts. Only "boa" ships
# today; the setting exists so another executor can be plugged in.
# VEKTOR_JOB_RUNTIME=boa
# Allow server-side fetches of user-configured URLs — job `fetch`, and an AI
# provider base URL — to reach loopback and private address ranges. Off by
# default: that is where the internal API, the database and cloud metadata
# endpoints live, and jobs have dedicated capabilities for the space data they
# need. Turn it on to point a space at a self-hosted Ollama on the private
# network, knowing a space owner can then aim it at any internal host and any
# viewer can read the reply.
# VEKTOR_JOB_FETCH_ALLOW_PRIVATE=1

# ── Observability ─────────────────────────────────────────────────────────────
# Ship logs to an OpenTelemetry collector, in addition to stdout/stderr. Unset
# means no export. Collector base URL, "/v1/logs" is appended.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Ingest credentials, if the collector wants them. Values are percent-decoded.
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20xxx
# OTEL_SERVICE_NAME=vektor
