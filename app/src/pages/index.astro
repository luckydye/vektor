---
import { FirstSpacePrompt } from "#components/FirstSpacePrompt.tsx";
import BaseLayout from "#layouts/BaseLayout.astro";
import {
  LAST_VISITED_SPACE_KEY,
  resolveActiveSpaceSlug,
} from "#utils/activeSpace.server.ts";

if (!Astro.locals.session) {
  return Astro.redirect("/login");
}

const activeSpaceSlug = await resolveActiveSpaceSlug(
  Astro.locals.user?.id,
  Astro.cookies.get(LAST_VISITED_SPACE_KEY)?.value,
);

if (activeSpaceSlug) {
  return Astro.redirect(`/${activeSpaceSlug}`);
}
---

<BaseLayout>
  <!-- First Space Onboarding Prompt -->
  <FirstSpacePrompt client:only="solid-js" />
</BaseLayout>
