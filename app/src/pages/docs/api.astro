---
import DocsContent from "#components/DocsContent.astro";
import Content, { getHeadings } from "#docs/api.md";
import DocsLayout from "#layouts/DocsLayout.astro";

const headings = getHeadings().filter((heading) => heading.depth === 2);
---

<DocsLayout title="API - Vektor" headings={headings}>
  <DocsContent>
    <Content />
  </DocsContent>
</DocsLayout>
