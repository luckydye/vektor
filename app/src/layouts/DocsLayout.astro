---
import DocsNav from "#components/DocsNav.astro";
import LandingLayout from "#layouts/LandingLayout.astro";

export interface Props {
  title?: string;
  /** Section outline for the current page, shown nested under its nav link. */
  headings?: { depth: number; slug: string; text: string }[];
}

const { title = "Docs - Vektor", headings } = Astro.props;

const docsNavigation = [
  {
    title: "Documentation",
    links: [
      { href: "/docs", label: "Overview" },
      { href: "/docs/api", label: "API" },
      { href: "/docs/permissions", label: "Permissions" },
      { href: "/docs/extensions", label: "Extensions" },
    ],
  },
];

const outline = (headings ?? [])
  .filter((heading) => heading.depth === 2)
  .map((heading) => ({ slug: heading.slug, text: heading.text }));

const currentPath = new URL(Astro.request.url).pathname.replace(/\/$/, "") || "/docs";
---

<LandingLayout title={title}>
  <div class="min-h-screen flex flex-col">
    <header
      class="sticky top-0 z-10 border-b border-primary-600/12 bg-background/80 backdrop-blur-sm"
    >
      <div class="max-w-[84rem] mx-auto flex items-center gap-3 px-5 sm:px-6 h-16">
        <a href="/" class="docs-logo shrink-0">
          <img src="/favicon_dark.png" alt="" class="docs-logo-mark docs-logo-mark-light">
          <img src="/favicon_light.png" alt="" class="docs-logo-mark docs-logo-mark-dark">
          Vektor
        </a>
        <span class="text-neutral-300">/</span>
        <a
          href="/docs"
          class="text-size-medium font-medium text-neutral-500 hover:text-primary-700 transition-colors"
        >
          Docs
        </a>
      </div>
    </header>

    <main class="flex-1 max-w-[84rem] w-full mx-auto px-5 sm:px-6">
      <div class="lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-12">
        <!-- Sidebar -->
        <aside class="hidden lg:block border-r border-primary-600/12">
          <nav
            class="docs-nav sticky top-16 max-h-[calc(100vh-4rem)] overflow-y-auto py-10 pr-6"
            aria-label="Documentation"
          >
            {docsNavigation.map((group) => (
                <div class="mb-8">
                  <DocsNav
                    title={group.title}
                    links={group.links}
                    currentPath={currentPath}
                    outline={outline}
                  />
                </div>
              ))}
          </nav>
        </aside>

        <!-- Content -->
        <article class="min-w-0 py-10 lg:py-14">
          <!-- Mobile section nav -->
          <details class="mb-8 lg:hidden">
            <summary
              class="flex cursor-pointer items-center justify-between rounded-xl border border-primary-600/20 bg-primary-600/5 px-4 py-3 text-size-medium font-semibold text-primary-700"
            >
              Browse documentation
              <svg
                aria-hidden="true"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M6 9l6 6 6-6" />
              </svg>
            </summary>
            <div class="mt-3 rounded-xl border border-primary-600/15 p-4">
              {docsNavigation.map((group) => (
                  <div class="mb-4 last:mb-0">
                    <DocsNav
                      title={group.title}
                      links={group.links}
                      currentPath={currentPath}
                      outline={outline}
                    />
                  </div>
                ))}
            </div>
          </details>

          <div class="max-w-[64rem]">
            <slot />
          </div>
        </article>
      </div>
    </main>
  </div>
</LandingLayout>

<style>
.docs-logo {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 1.25rem;
  font-weight: 700;
  letter-spacing: -0.04em;
  color: var(--color-neutral-900);
}

.docs-logo-mark {
  display: block;
  height: 1.75rem;
  width: 1.75rem;
  object-fit: contain;
}

.docs-logo-mark-dark {
  display: none;
}

@media (prefers-color-scheme: dark) {
  .docs-logo-mark-light {
    display: none;
  }

  .docs-logo-mark-dark {
    display: block;
  }
}

/* The sidebar scrolls with a long outline: it owns the horizontal inset the
   active pill is drawn into, since a scroll container clips what sits outside
   its padding box. */
.docs-nav {
  margin-left: -0.7rem;
  padding-left: 0.7rem;
  scrollbar-width: thin;
  scrollbar-color: color-mix(in srgb, var(--color-neutral-300) 60%, transparent)
    transparent;
}
</style>

<script>
// Doc content is rendered inside a declarative shadow root, so heading ids
// (and thus native #anchor scrolling) aren't reachable via document.getElementById —
// resolve and scroll to them manually instead.
function contentRoot() {
  return document.querySelector("docs-content")?.shadowRoot ?? null;
}

function scrollToHash(hash) {
  const id = hash.replace(/^#/, "");
  if (!id) return;
  contentRoot()
    ?.getElementById(id)
    ?.scrollIntoView({ behavior: "smooth", block: "start" });
}

document.addEventListener("click", (event) => {
  const link = event.target?.closest?.('a[href^="#"]');
  if (!link) return;
  const hash = link.getAttribute("href") ?? "";
  if (hash.length < 2) return;

  event.preventDefault();
  history.pushState(null, "", hash);
  scrollToHash(hash);
});

if (location.hash) {
  requestAnimationFrame(() => scrollToHash(location.hash));
}

/**
 * Marks the outline entry for the section the reader is in. Driven by scroll
 * position rather than IntersectionObserver — with headings this close together
 * several are on screen at once, and "the last one passed" is the answer a
 * reader expects.
 */
function trackOutline() {
  const root = contentRoot();
  const links = [...document.querySelectorAll(".docs-nav-outline-link")];
  if (!root || links.length === 0) return;

  // The outline is rendered twice — sticky sidebar and mobile disclosure — so a
  // heading is tracked once and every link pointing at it is marked together.
  const entries = [...new Set(links.map((link) => link.getAttribute("href")))]
    .map((href) => ({ href, heading: root.getElementById(href.slice(1)) }))
    .filter((entry) => entry.heading);

  /** Keeps the marked entry visible without scrolling the page with it. */
  const revealInNav = () => {
    const link = document.querySelector('.docs-nav [aria-current="true"]');
    const nav = link?.closest(".docs-nav");
    if (!nav) return;
    const bounds = nav.getBoundingClientRect();
    const entry = link.getBoundingClientRect();
    if (entry.top < bounds.top) nav.scrollTop -= bounds.top - entry.top + 16;
    else if (entry.bottom > bounds.bottom) {
      nav.scrollTop += entry.bottom - bounds.bottom + 16;
    }
  };

  let frame = 0;
  let marked = null;
  const update = () => {
    frame = 0;
    // The sticky header's height, so a heading tucked under it doesn't count.
    const cutoff = 96;
    let active = entries[0].href;
    for (const entry of entries) {
      if (entry.heading.getBoundingClientRect().top <= cutoff) active = entry.href;
    }
    if (active === marked) return;
    marked = active;

    for (const link of links) {
      const isActive = link.getAttribute("href") === active;
      if (isActive) link.setAttribute("aria-current", "true");
      else link.removeAttribute("aria-current");
    }

    revealInNav();
  };

  addEventListener(
    "scroll",
    () => {
      if (!frame) frame = requestAnimationFrame(update);
    },
    { passive: true },
  );
  update();
}

trackOutline();
</script>
