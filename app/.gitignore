# build output
dist/
src/generated/
# generated types
.astro/

# native image addon (Rust) build artifacts — built per platform in CI / setup
native/image/target/
src/files/native/*.node
src/files/native/addon.ts
native/exec/target/
src/exec/native/*.node
src/exec/native/addon.ts

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

/vektor

# A bare directory name here would exclude `generated/` itself from being
# walked at all, and a negation below can't re-include a path inside an
# excluded directory — hence `generated/*`, not `generated`.
generated/*
# ...except the OpenAPI schema: committed so it's reviewable in diffs, even
# though `server.ts`/`task compile` regenerate it from the route doc comments.
!generated/openapi.ts

data/**/*

.results

# frames kept by `record-onboarding.ts --keep-frames`
scripts/.onboarding-frames/