---
import {
  LAST_VISITED_SPACE_KEY,
  resolveActiveSpaceSlug,
} from "#utils/activeSpace.server.ts";

if (!Astro.locals.session) {
  return Astro.redirect("/login");
}

const activeSpaceSlug = await resolveActiveSpaceSlug(
  Astro.locals.user?.id,
  Astro.cookies.get(LAST_VISITED_SPACE_KEY)?.value,
);

// No reachable space means there is nothing for a space-scoped route to render,
// so the overview takes over: it states the empty case and offers creation only
// when the account is allowed it.
return Astro.redirect(activeSpaceSlug ? `/${activeSpaceSlug}` : "/spaces");
---

